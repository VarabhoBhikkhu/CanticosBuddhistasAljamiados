#paritta[
#sidepar[A.]#metadata((tipo: "primera-linea", texto: "Pharitvāna mettaṁ samettā bhadantā")) <primera-linea>#metadata((tipo: "primera-linea", texto: "Samantā cakka-vāḷesu")) <primera-linea>
Pharitvāna mettaṁ samettā bhadantā #linebreak() 
Avikkhitta-cittā parittaṁ bhaṇantu

#sidepar[B.]
Samantā cakka-vāḷesu #linebreak() 
Atr'āgacchantu devatā #linebreak() 
Saddhammaṁ muni-rājassa #linebreak() 
Suṇantu sagga-mokkha-daṁ

Sagge kāme ca rūpe #linebreak() 
Giri-sikhara-taṭe c'antalikkhe vimāne #linebreak() 
Dīpe raṭṭhe ca gāme #linebreak() 
Taru-vana-gahane geha-vatthumhi khette #linebreak() 
Bhummā c'āyantu devā #linebreak() 
Jala-thala-visame yakkha-gandhabba-nāgā #linebreak() 
Tiṭṭhantā santike yaṁ #linebreak() 
Muni-vara-vacanaṁ sādhavo me suṇantu

Dhammassavana-kālo ayam-bhadantā

#instr[Tres veces, o la alternativa]

Buddha-dassana-kālo ayam-bhadantā #linebreak() 
Dhammassavana-kālo ayam-bhadantā #linebreak() 
Saṅgha-payirūpāsana-kālo ayam-bhadantā
]

#pagebreak()

#capitulo("Pubba-bhāga-nama-kāra-pāṭho")
#metadata((tipo: "cap", titulo: "Pubba-bhāga-nama-kāra-pāṭho")) <toc>

#paritta[#metadata((tipo: "primera-linea", texto: "Namo tassa Bhagavato")) <primera-linea>
Namo tassa bhagavato arahato sammā-sambuddhassa #linebreak() 
Namo tassa bhagavato arahato sammā-sambuddhassa #linebreak() 
Namo tassa bhagavato arahato sammā-sambuddhassa
]

#capitulo("Saraṇa-gamana-pāṭho")
#metadata((tipo: "cap", titulo: "Saraṇa-gamana-pāṭho")) <toc>

#paritta[#metadata((tipo: "primera-linea", texto: "Buddhaṁ saraṇaṁ gacchāmi")) <primera-linea>
Buddhaṁ saraṇaṁ gacchāmi #linebreak() 
Dhammaṁ saraṇaṁ gacchāmi #linebreak() 
Saṅghaṁ saraṇaṁ gacchāmi

Dutiyam pi buddhaṁ saraṇaṁ gacchāmi #linebreak() 
Dutiyam pi dhammaṁ saraṇaṁ gacchāmi #linebreak() 
Dutiyam pi saṅghaṁ saraṇaṁ gacchāmi

Tatiyam pi buddhaṁ saraṇaṁ gacchāmi #linebreak() 
Tatiyam pi dhammaṁ saraṇaṁ gacchāmi #linebreak() 
Tatiyam pi saṅghaṁ saraṇaṁ gacchāmi
]

#pagebreak()

#capitulo("Nama-kāra-siddhi-gāthā")
#metadata((tipo: "cap", titulo: "Nama-kāra-siddhi-gāthā")) <toc>

#paritta[#metadata((tipo: "primera-linea", texto: "Yo cakkhumā moha-malāpakaṭṭho")) <primera-linea>
Yo cakkhumā moha-malāpakaṭṭho #linebreak() 
Sāmaṁ va buddho sugato vimutto #linebreak() 
Mārassa pāsā vinimocayanto #linebreak() 
Pāpesi khemaṁ janataṁ vineyyaṁ #linebreak() 
Buddhaṁ varan-taṁ sirasā namāmi #linebreak() 
Lokassa nāthañ-ca vināyakañ-ca #linebreak() 
Tan-tejasā te jaya-siddhi hotu #linebreak() 
Sabb'antarāyā ca vināsamentu

Dhammo dhajo yo viya tassa satthu #linebreak() 
Dassesi lokassa visuddhi-maggaṁ #linebreak() 
Niyyāniko dhamma-dharassa dhārī #linebreak() 
Sāt'āvaho santi-karo suciṇṇo #linebreak() 
Dhammaṁ varan-taṁ sirasā namāmi #linebreak() 
Mohappadālaṁ upasanta-dāhaṁ #linebreak() 
Tan-tejasā te jaya-siddhi hotu #linebreak() 
Sabb'antarāyā ca vināsamentu

Saddhamma-senā sugatānugo yo #linebreak() 
Lokassa pāpūpakilesa-jetā #linebreak() 
Santo sayaṁ santi-niyojako ca #linebreak() 
Svākkhāta-dhammaṁ viditaṁ karoti #linebreak() 
Saṅghaṁ varan-taṁ sirasā namāmi #linebreak() 
Buddhānubuddhaṁ sama-sīla-diṭṭhiṁ #linebreak() 
Tan-tejasā te jaya-siddhi hotu #linebreak() 
Sabb'antarāyā ca vināsamentu
]

#pagebreak()

#capitulo("Namo-kāra-aṭṭhaka")
#metadata((tipo: "cap", titulo: "Namo-kāra-aṭṭhaka")) <toc>

#paritta[#metadata((tipo: "primera-linea", texto: "Namo arahato sammā")) <primera-linea>
Namo arahato sammā #linebreak() 
Sambuddhassa mahesino #linebreak() 
Namo uttama-dhammassa #linebreak() 
Svākkhātass'eva ten'idha #linebreak() 
Namo mahā-saṅghassāpi #linebreak() 
Visuddha-sīla-diṭṭhino #linebreak() 
Namo omāty-āraddhassa #linebreak() 
Ratanattayassa sādhukaṁ #linebreak() 
Namo omakātītassa #linebreak() 
Tassa vatthuttayassa-pi #linebreak() 
Namo-kārappabhāvena #linebreak() 
Vigacchantu upaddavā #linebreak() 
Namo-kārānubhāvena #linebreak() 
Suvatthi hotu sabbadā #linebreak() 
Namo-kārassa tejena #linebreak() 
Vidhimhi homi tejavā #linebreak() 
]

#pagebreak()

#capitulo("Ratana-sutta")
#metadata((tipo: "cap", titulo: "Ratana-sutta")) <toc>

#paritta[#metadata((tipo: "primera-linea", texto: "Yaṅkiñci vittaṁ idha vā huraṁ vā")) <primera-linea>

Yaṅkiñci vittaṁ idha vā huraṁ vā #linebreak() 
Saggesu vā yaṁ ratanaṁ paṇītaṁ #linebreak() 
Na no samaṁ atthi tathāgatena #linebreak() 
Idam-pi buddhe ratanaṁ paṇītaṁ #linebreak() 
Etena saccena suvatthi hotu

Khayaṁ virāgaṁ amataṁ paṇītaṁ #linebreak() 
Yad-ajjhagā sakya-munī samāhito #linebreak() 
Na tena dhammena sam'atthi kiñci #linebreak() 
Idam-pi dhamme ratanaṁ paṇītaṁ #linebreak() 
Etena saccena suvatthi hotu

Yam buddha-seṭṭho parivaṇṇayī suciṁ #linebreak() 
Samādhim-ānantarikaññam-āhu #linebreak() 
Samādhinā tena samo na vijjati #linebreak() 
Idam-pi dhamme ratanaṁ paṇītaṁ #linebreak() 
Etena saccena suvatthi hotu

Ye puggalā aṭṭha sataṁ pasaṭṭhā #linebreak() 
Cattāri etāni yugāni honti #linebreak() 
Te dakkhiṇeyyā sugatassa sāvakā #linebreak() 
Etesu dinnāni mahapphalāni #linebreak() 
Idam-pi saṅghe ratanaṁ paṇītaṁ #linebreak() 
Etena saccena suvatthi hotu

]#pagebreak()
#paritta[

Ye suppayuttā manasā daḷhena #linebreak() 
Nikkāmino gotama-sāsanamhi #linebreak() 
Te patti-pattā amataṁ vigayha #linebreak() 
Laddhā mudhā nibbutiṁ bhuñjamānā #linebreak() 
Idam-pi saṅghe ratanaṁ paṇītaṁ #linebreak() 
Etena saccena suvatthi hotu

Khīṇaṁ purāṇaṁ navaṁ n'atthi sambhavaṁ #linebreak() 
Viratta-citt'āyatike bhavasmiṁ #linebreak() 
Te khīṇa-bījā aviruḷhi-chandā #linebreak() 
Nibbanti dhīrā yathā'yam padīpo #linebreak() 
Idam-pi saṅghe ratanaṁ paṇītaṁ #linebreak() 
Etena saccena suvatthi hotu

]

#pagebreak()

#capitulo("Maṅgala-sutta")
#metadata((tipo: "cap", titulo: "Maṅgala-sutta")) <toc>

#paritta[#metadata((tipo: "primera-linea", texto: "Asevanā ca bālānaṁ")) <primera-linea>
Asevanā ca bālānaṁ #linebreak() 
Paṇḍitānañ-ca sevanā #linebreak() 
Pūjā ca pūjanīyānaṁ #linebreak() 
Etam maṅgalam-uttamaṁ

Paṭirūpa-desa-vāso ca #linebreak() 
Pubbe ca kata-puññatā #linebreak() 
Atta-sammā-paṇidhi ca #linebreak() 
Etam maṅgalam-uttamaṁ

Bāhu-saccañ-ca sippañ-ca, #linebreak() 
Vinayo ca susikkhito #linebreak() 
Subhāsitā ca yā vācā #linebreak() 
Etam maṅgalam-uttamaṁ

Mātā-pitu-upaṭṭhānaṁ #linebreak() 
Putta-dārassa saṅgaho #linebreak() 
Anākulā ca kammantā #linebreak() 
Etam maṅgalam-uttamaṁ

Dānañ-ca dhamma-cariyā ca #linebreak() 
Ñātakānañ-ca saṅgaho #linebreak() 
Anavajjāni kammāni #linebreak() 
Etam maṅgalam-uttamaṁ

Āratī viratī pāpā #linebreak() 
Majja-pānā ca saññamo #linebreak() 
Appamādo ca dhammesu #linebreak() 
Etam maṅgalam-uttamaṁ

Gāravo ca nivāto ca #linebreak() 
Santuṭṭhī ca kataññutā #linebreak() 
Kālena dhammassavanaṁ #linebreak() 
Etam maṅgalam-uttamaṁ

Khantī ca sovacassatā #linebreak() 
Samaṇānañ-ca dassanaṁ #linebreak() 
Kālena dhamma-sākacchā #linebreak() 
Etam maṅgalam-uttamaṁ

Tapo ca brahma-cariyañ-ca #linebreak() 
Ariya-saccāna-dassanaṁ #linebreak() 
Nibbāna-sacchikiriyā ca #linebreak() 
Etam maṅgalam-uttamaṁ

Phuṭṭhassa loka-dhammehi #linebreak() 
Cittaṁ yassa na kampati #linebreak() 
Asokaṁ virajaṁ khemaṁ #linebreak() 
Etam maṅgalam-uttamaṁ

Etādisāni katvāna #linebreak() 
Sabbattham-aparājitā #linebreak() 
Sabbattha sotthiṁ gacchanti #linebreak() 
Tan-tesaṁ maṅgalam-uttaman'ti

]

#pagebreak()

#capitulo("Karaṇīya-metta-sutta")
#metadata((tipo: "cap", titulo: "Karaṇīya-metta-sutta")) <toc>

#paritta[#metadata((tipo: "primera-linea", texto: "Karaṇīyam-attha-kusalena")) <primera-linea>
Karaṇīyam-attha-kusalena #linebreak() 
Yan-taṁ santaṁ padaṁ abhisamecca #linebreak() 
Sakko ujū ca suhujū ca #linebreak() 
Suvaco c'assa mudu anatimānī

Santussako ca subharo ca #linebreak() 
Appakicco ca sallahuka-vutti #linebreak() 
Sant'indriyo ca nipako ca #linebreak() 
Appagabbho kulesu ananugiddho

Na ca khuddaṁ samācare kiñci #linebreak() 
Yena viññū pare upavadeyyuṁ #linebreak() 
Sukhino vā khemino hontu #linebreak() 
Sabbe sattā bhavantu sukhit'attā

Ye keci pāṇa-bhūt'atthi #linebreak() 
Tasā vā thāvarā vā anavasesā #linebreak() 
Dīghā vā ye mahantā vā #linebreak() 
Majjhimā rassakā aṇuka-thūlā

Diṭṭhā vā ye ca adiṭṭhā #linebreak() 
Ye ca dūre vasanti avidūre #linebreak() 
Bhūtā vā sambhavesī vā #linebreak() 
Sabbe sattā bhavantu sukhit'attā

Na paro paraṁ nikubbetha #linebreak() 
Nātimaññetha katthaci naṁ kiñci #linebreak() 
Byārosanā paṭighasaññā #linebreak() 
Nāññam-aññassa dukkham-iccheyya

Mātā yathā niyaṁ puttaṁ #linebreak() 
Āyusā eka-puttam-anurakkhe #linebreak() 
Evam'pi sabba-bhūtesu #linebreak() 
Mānasam-bhāvaye aparimāṇaṁ

Mettañ-ca sabba-lokasmiṁ #linebreak() 
Mānasam-bhāvaye aparimāṇaṁ #linebreak() 
Uddhaṁ adho ca tiriyañ-ca #linebreak() 
Asambādhaṁ averaṁ asapattaṁ

Tiṭṭhañ-caraṁ nisinno vā #linebreak() 
Sayāno vā yāvat'assa vigata-middho #linebreak() 
Etaṁ satiṁ adhiṭṭheyya #linebreak() 
Brahmam-etaṁ vihāraṁ idham-āhu

Diṭṭhiñca anupagamma #linebreak() 
Sīlavā dassanena sampanno #linebreak() 
Kāmesu vineyya gedhaṁ #linebreak() 
Na hi jātu gabbha-seyyaṁ punaretī'ti

]

